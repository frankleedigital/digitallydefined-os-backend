# DigitallyDefined — OmniRoute Linode integration
# Generated from real OmniRoute docs + live local instance state.
#
# Source of truth for values:
#   Linode ~/.omniroute/.env  (JWT_SECRET, OMNIROUTE_WS_BRIDGE_SECRET, etc.)
#   Local OmniRoute CLI env    (JWT auth shape, BASE_URL shape, DATA_DIR)
#   DigitallyDefined backend   (lib/omniroute.js — fetch pattern)
#
# Auth mode: JWT Bearer token (not remote-mode access token / oma_live_*).
# OmniRoute API port on Linode: 20128
# OmniRoute dashboard port on Linode: 20129 (per your readme)
#
# CONSTRAINT: no new providers, no new models, no new routing rules.
# Hermes + backend adapt to whatever OmniRoute already has.

# =============================================================================
# 1. OMNIROUTE — Linode target (the gateway DigitallyDefined uses)
# =============================================================================
# Base URL for ALL AI traffic. Same value for Hermes, backend, and any client.
OMNIROUTE_BASE_URL=http://45.79.180.236:20128

# The JWT Bearer token that authenticates to the Linode's OmniRoute.
# SOURCE: Linode ~/.omniroute/.env → JWT_SECRET + OmniRoute's token mint.
# This is the ONE value that must come from the Linode. Everything else below
# is real and already known from the local instance + backend code.
#
# To get it once:
#   1. SSH to the Linode
#   2. cat ~/.omniroute/.env  → read JWT_SECRET=<value>
#   3. OmniRoute mints JWTs from that secret; the exact JWT to use is the one
#      the dashboard / CLI already uses. If the Linode has an admin session:
#        - open the Linode dashboard at https://<your-domain>/dashboard
#        - the Bearer token in the dashboard's network requests IS the JWT
#        - OR: if omniroute CLI is configured on the Linode: omniroute env get JWT_SECRET
#   4. Paste the full JWT below.
OMNIROUTE_API_KEY=sk-<LINODE_JWT_HERE>

# Default model — leave "free" so OmniRoute's own routing picks the provider.
# Hermes and backend request "free"; OmniRoute resolves it to a real model.
OMNIROUTE_MODEL=free

# Fallback models — leave empty. OmniRoute's built-in per-provider fallback
# handles failures; do NOT invent fallback models the gateway doesn't know.
OMNIROUTE_FALLBACK_MODEL_1=
OMNIROUTE_FALLBACK_MODEL_2=

# Request timeout (matches backend lib/omniroute.js default: 60000)
OMNIROUTE_TIMEOUT_MS=60000

# =============================================================================
# 2. MACHINE IDENTITY — Hermes + backend are bound to this machine ID
# =============================================================================
# From the local instance's api_keys table: all 4 keys (DigitallyDefined,
# Supabase, hermes, hermes-local) are bound to machine_id fcfcf4cfe8fd70e5.
#
# The Linode instance may have a DIFFERENT machine ID. If the Linode's api_keys
# table shows a different machine_id for the "hermes" key, use that instead.
# To check: on the Linode, sqlite3 ~/.omniroute/data/storage.sqlite
#   "SELECT id, name, key_prefix, machine_id FROM api_keys WHERE name='hermes';"
#
# For now, use the local instance's machine ID as the placeholder — replace
# with the Linode's value once you confirm it.
OMNIROUTE_MACHINE_ID=fcfcf4cfe8fd70e5

# =============================================================================
# 3. WS BRIDGE — for streaming / long-lived agent connections (optional)
# =============================================================================
# The Linode's OmniRoute may expose a WebSocket bridge for Codex Responses
# streaming and agent ops. To use it, Hermes needs the bridge secret.
#
# SOURCE: Linode ~/.omniroute/.env → OMNIROUTE_WS_BRIDGE_SECRET
# To get it once: SSH to Linode, cat ~/.omniroute/.env, read the value.
#
# Leave empty if Hermes doesn't need streaming (HTTP /v1/chat/completions
# with stream:true is sufficient for most workflows).
OMNIROUTE_WS_BRIDGE_SECRET=

# WebSocket bridge endpoint — same base URL, WS scheme.
OMNIROUTE_WS_URL=ws://45.79.180.236:20128

# =============================================================================
# 4. BACKEND SECRETS — only the backend should consume these, never the browser
# =============================================================================
# These mirror the Linode's OmniRoute config. The backend uses them for any
# operation that needs to verify tokens, decrypt storage, or manage keys.
# Do NOT expose these to the Vite frontend .env.
JWT_SECRET=<LINODE_JWT_SECRET_HERE>
API_KEY_SECRET=<LINODE_API_KEY_SECRET_HERE>
STORAGE_ENCRYPTION_KEY=<LINODE_STORAGE_ENCRYPTION_KEY_HERE>
STORAGE_ENCRYPTION_KEY_VERSION=v1

# =============================================================================
# 5. DASHBOARD / MANAGEMENT — separate port for the dashboard UI
# =============================================================================
# The Linode maps the dashboard to 20129 (per your readme). Hermes and the
# backend don't talk to the dashboard directly — they use 20128 for APIs.
# This is here for reference / any tool that opens the dashboard.
OMNIROUTE_DASHBOARD_URL=http://45.79.180.236:20129

# =============================================================================
# 6. ROUTING — Hermes-side policy (no OmniRoute changes)
# =============================================================================
# Hermes requests "free" and lets OmniRoute resolve the actual provider/model.
# This matches the backend's lib/omniroute.js behavior (model: currentModel,
# with fallback chain handled by the gateway, not the client).
#
# Per-task guidance (informational — Hermes decides per-request, OmniRoute routes):
#   dashboard / lookup / tool-call  → model: "free", priority: latency
#   content / brief / seo / strategy → model: "free", priority: quality
#   automation / sync / bulk         → model: "free", priority: latency
#   fallback (any failure)           → retry once with model: "free"
#
# Hermes must NOT:
#   - request a model not in OmniRoute's catalog
#   - call Groq/Antigravity/Nous/etc. directly (bypass OmniRoute)
#   - use a key not bound to the machine ID above
#   - log the JWT or API key in plaintext
