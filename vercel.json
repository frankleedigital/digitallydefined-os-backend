{
  "builds": [
    { "src": "api/**/*.js", "use": "@vercel/node" }
  ],
  "functions": {
    "api/**/*.js": {
      "runtime": "nodejs@20.x"
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/index.js" },
    { "source": "/api", "destination": "/api/index.js" },
    { "source": "/hermes-mcp", "destination": "/api/hermes-mcp.js" },
    { "source": "/mcp", "destination": "/api/hermes-mcp.js" }
  ]
}
