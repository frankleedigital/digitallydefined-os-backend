{
  "functions": {
    "api/*.js": {
      "runtime": "nodejs20.x"
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/index.js" },
    { "source": "/api", "destination": "/api/index.js" },
    { "source": "/hermes-mcp", "destination": "/api/hermes-mcp" },
    { "source": "/mcp", "destination": "/api/hermes-mcp" }
  ]
}
