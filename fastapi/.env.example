# DigitallyDefined FastAPI — environment configuration
# Copy to ../.env (next to the backend repo root) or export in your shell.

# --- App ---
ENVIRONMENT=development

# --- Supabase (same project as the live backend) ---
SUPABASE_URL=https://dijjlppdljpcgyoakdnq.supabase.co
SUPABASE_SERVICE_KEY=

# --- API-key auth (mirror edge `x-api-key` contract) ---
DASHBOARD_API_KEY=DigitallyDefined-OS-2026

# --- OmniRoute AI gateway (Linode — the live gateway for Hermes) ---
# When run from the fastapi/ dir, ../.env (the backend .env) is loaded and
# overrides these, so the real key/base are picked up automatically.
OMNIROUTE_BASE_URL=https://ai.digitallydefined.online/v1
OMNIROUTE_API_KEY=
# Primary model. Use a provider-backed model (e.g. tllm/, aug/, ddgw/) or a
# valid auto/ alias. Do NOT use the plain "auto" or "auto/best-free" ids: the
# gateway rejects both with 401 ("No active credentials"), so they add a wasted
# round-trip to every request before a working model is reached.
OMNIROUTE_MODEL=auto/cheap
# Ordered fallback chain (JSON array) tried in turn when the primary fails.
# Ordered fastest-measured-first: this chain's 8-22s spread dominates the
# latency of an uncached tool call (see the timing table in app/llm.py).
OMNIROUTE_FALLBACK_MODELS=["auto/cheap","auto/best-fast","auto/chat","auto/best-chat"]

# --- Puter workspace (optional) ---
PUTER_ENABLED=false
PUTER_API_KEY=

# --- Output dir for packaged files ---
OUTPUT_DIR=output