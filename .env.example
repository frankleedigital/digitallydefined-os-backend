# DigitallyDefined OS Backend — Environment Template
# Set real values in: local .env (Node/Vercel) AND Supabase Dashboard → Edge Functions → Secrets
# NEVER commit real values.

# ============================================================
# AI — OmniRoute ONLY (single gateway, self-hosted on Linode)
# Base URL may include or omit the trailing /v1; clients normalize it.
# The Linode gateway port is 20128 (dashboard: 20129).
# ============================================================
OMNIROUTE_BASE_URL=http://45.79.180.236:20128/v1
OMNIROUTE_API_KEY=sk-your-omniroute-jwt-here
OMNIROUTE_MODEL=auto

# ============================================================
# FastAPI microservice layer
# (product-generator / niche / domain / affiliate / rank-rent /
#  blueprint / roadmap / trends) — reached via /fastapi/* proxy + fastapi.* actions.
# ============================================================
FASTAPI_BASE_URL=http://localhost:8000
# Shared key the backend proxy forwards to FastAPI as `x-api-key`.
# Keep aligned with DASHBOARD_API_KEY so FastAPI auth accepts it.
FASTAPI_API_KEY=your-shared-api-key-here

# ============================================================
# Direct-Gemini fallback (OpenAI-compatible endpoint) used only when OmniRoute
# is unreachable. GEMINI_MODEL can be an alias the direct endpoint resolves.
# ============================================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ============================================================
# Shared API key (frontend sends x-api-key; edge + backend verify it)
# Frontends mirror this value as VITE_DASHBOARD_API_KEY.
# ============================================================
DASHBOARD_API_KEY=your-shared-api-key-here

# Supabase
SUPABASE_URL=https://dijjlppdljpcgyoakdnq.supabase.co
SUPABASE_ANON_KEY=

# Notion Integration
NOTION_API_KEY=
NOTION_LIVE_MODE=true
NOTION_IDEAS_DB_ID=
NOTION_CONTENT_DB_ID=
NOTION_AUTOMATIONS_DB_ID=
NOTION_COMMAND_CENTER_DB_ID=
NOTION_PUBLISHING_QUEUE_DB_ID=
NOTION_CONTENT_APPROVALS_DB_ID=
NOTION_BUYER_SIGNALS_DB_ID=
NOTION_AI_CONTENT_DRAFTS_DB_ID=
NOTION_WEBHOOK_SECRET=
# notion-sync target databases (fall back to NOTION_AUTOMATIONS_DB_ID)
NOTION_LEADS_DB_ID=
NOTION_QUIZ_RESULTS_DB_ID=
NOTION_CONTACT_MESSAGES_DB_ID=
# notion-sync scan window (minutes) — defaults to 420 (7h, overlaps the 6h cron)
NOTION_SYNC_WINDOW_MIN=420

# Social Media
FACEBOOK_GROUP_ID=
FACEBOOK_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# Email
BREVO_API_KEY=
BREVO_LIST_ID=

# Google Sheets
SHEETS_WEBHOOK_URL=

# Business
GUMROAD_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=

# Communication (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=

# Testing OmniRoute:
#   node scripts/test-omniroute.js
