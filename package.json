{
  "name": "digitallydefined-backend",
  "version": "1.0.0",
  "description": "DigitallyDefined API Backend - Powers the website and dashboard with Hermes AI integration",
  "type": "module",
  "main": "api/index.js",
  "scripts": {
    "dev:supabase": "supabase start",
    "dev:hermes": "supabase functions serve hermes --env-file .env --no-verify-jwt",
    "dev:mcp": "node scripts/hermes-mcp-server.mjs",
    "build": "node scripts/build.js",
    "smoke:mcp": "node scripts/smoke-hermes-mcp.mjs",
    "dev": "node scripts/dev.js",
    "start": "npm run dev"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@supabase/supabase-js": "^2.112.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.22.2"
  },
  "devDependencies": {
    "@types/node": "^26.4.0"
  }
}
