# ===========================================
# OmniRoute Configuration (OmniRoute ONLY)
# ===========================================
# Unified AI gateway for DigitallyDefined OS.
# There are NO other AI providers, NO fallback models, and NO fallback providers.
# All AI traffic flows through OmniRoute, which routes to upstream providers itself.

# Required: OmniRoute API key (JWT Bearer token from your OmniRoute instance)
OMNIROUTE_API_KEY=sk-your-omniroute-api-key-here

# Optional: OmniRoute base URL (default: https://api.omniroute.ai/v1)
# Use this if you're self-hosting OmniRoute (e.g. http://45.79.180.236:20128)
OMNIROUTE_BASE_URL=https://api.omniroute.ai/v1

# Optional: Default model. "auto" lets OmniRoute pick the best available model.
OMNIROUTE_MODEL=auto

# There are no OMNIROUTE_FALLBACK_MODEL_* variables. Provider fallback is
# handled entirely inside OmniRoute — the backend makes exactly one attempt
# per request and surfaces any error to the caller.

# ===========================================
# Backend Configuration
# ===========================================
# Dashboard API Key (for frontend authentication)
DASHBOARD_API_KEY=your-dashboard-api-key-here

# ===========================================
# Testing
# ===========================================
# Verify the configuration:
#   node scripts/test-omniroute.js
